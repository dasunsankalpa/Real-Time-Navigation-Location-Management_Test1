# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/smart-virtual-tourist
MONGODB_DB_NAME=tourismGuideDB

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here

# API Configuration
API_TIMEOUT=30000

# Google Places API
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Recent Places Defaults
RECENT_PLACES_DEFAULT_USER_ID=testUser01
